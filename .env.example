# Sao chép thành .env.local rồi sửa. Các biến EXPO_PUBLIC_* được nhúng vào app nên KHÔNG đặt bí mật ở đây.

# Địa chỉ API (đi qua Next.js của web, giống trình duyệt)
EXPO_PUBLIC_API_BASE_URL=https://clead.io.vn/backend/api

# WebSocket thông báo (STOMP thuần, không SockJS)
EXPO_PUBLIC_WS_URL=wss://clead.io.vn/ws/notifications

# Tên miền đã đăng ký cho khóa Cloudflare Turnstile; WebView dùng làm baseUrl để vượt kiểm tra tên miền
EXPO_PUBLIC_SITE_ORIGIN=https://clead.io.vn
