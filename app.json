{
  "expo": {
    "name": "C-LEAD",
    "slug": "clead",
    "scheme": "clead",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.io.clead.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "vn.io.clead.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "color": "#1e40af"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép C-LEAD dùng camera để quét mã QR điểm danh.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép C-LEAD đọc ảnh để tìm mã QR trong ảnh.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "Ứng dụng di động quản lý huynh trưởng C-LEAD.",
    "extra": {
      "eas": {
        "projectId": "9b9b8858-596a-4b9f-b974-4fcc35319386"
      }
    },
    "owner": "dat107001dev",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9b9b8858-596a-4b9f-b974-4fcc35319386",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
